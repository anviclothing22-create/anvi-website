# === ANVI Storefront — copy to .env.local (dev) or set in Vercel/Netlify ===
# Supabase (same project as admin; anon key only — RLS enforced)
VITE_SUPABASE_URL=https://xyzcompany-staging.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...staging-anon-key

# App URLs
VITE_APP_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
VITE_API_URL=https://xyzcompany-staging.supabase.co/functions/v1

# Ops flags
VITE_WHATSAPP_NUMBER=919994837459
VITE_ENV=development

# --- Optional / not yet wired (safe to leave empty) ---
# Razorpay Standard Checkout (test mode). KEY_ID is publishable and ships
# to the client. KEY_SECRET must NEVER be a VITE_ var — it lives only in
# Supabase Edge Function secrets: `supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=...`
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# COD cap enforced server-side in create_order; no client gate yet.
VITE_ENABLE_COD=true
VITE_COD_MAX_AMOUNT=2500
# Observability SDKs not installed — set only after adding Sentry/PostHog/GA.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_GA_ID=

# --- Scripts only (scripts/seed.ts, never VITE_ — do NOT expose to client) ---
# SUPABASE_URL=https://xyzcompany-staging.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key
